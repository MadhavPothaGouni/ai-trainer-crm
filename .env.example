# Copy to .env and fill in before running `docker compose up` for anything
# beyond throwaway local testing - every one of these has a default baked into
# docker-compose.yml (matching crm-platform's own application.yml defaults),
# so the stack runs without this file too, just not securely.

# --- Postgres ---
DB_NAME=ai_trainer_crm
DB_USERNAME=crm_user
DB_PASSWORD=crm_password

# --- RabbitMQ ---
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Backend ---
# Must be at least 256 bits (32 chars) - it signs every access token. Generate
# one with, e.g., `openssl rand -base64 32`.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_this_must_be_at_least_256_bits_long
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
